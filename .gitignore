# The Python environment from step 3 of the README. It is rebuilt from
# pyproject.toml, so it never belongs in the repository.
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Notebook run state. Outputs stay in the file -- a lab you have run is your
# own work -- but the checkpoint copies are noise.
.ipynb_checkpoints/

.DS_Store

# Module 3's payload, and everything its loaders generate from it. That
# module's README says why it is never committed: larger than git should
# carry, and rebuilt rather than edited.
modules/03-where-data-lives/import
/module-03-payload.zip
/SHA256SUMS.txt
